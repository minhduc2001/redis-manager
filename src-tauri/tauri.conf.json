{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Redis Manager",
  "version": "0.1.4",
  "identifier": "com.redis-manager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Redis Manager",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFNTZGQjhEMjc1Q0I1OTUKUldTVnRWd25qZnRXYmtRYXdkbS80K1JoOVZYWGFMdXJvZTZ2OWpOUkZjcGxpQ21sQWxFMVQyU2IK",
      "endpoints": [
        "https://github.com/minhduc2001/redis-manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}